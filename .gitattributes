* text=auto

*.py text eol=lf
*.sh text eol=lf
*.command text eol=lf
scripts/hooks/* text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.bin binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.gz binary
*.zst binary

# Recorded code-task fixtures: the journals hold the hash of these exact bytes, so no checkout may rewrite their line endings.
tests/fixtures/code_task_journals/**/workspace/** -text

# Vendored third-party files and pinned data: a manifest, a canonical hash or a signed package holds
# the hash of these exact bytes, so no checkout (Windows' CRLF one included) may rewrite their line endings.
core/web_assets/** -text
core/wallet/bip39_english.txt -text
docs/registry/examples/** -text
